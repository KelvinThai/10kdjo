# Production env vars. Copy to /opt/10kdjo/.env on the VM and fill in.
# This file is loaded by docker-compose.prod.yml via `env_file: .env`.

# ─── Postgres ─────────────────────────────────────────────────────────
POSTGRES_USER=10kdjo
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_DB=10kdjo

# DATABASE_URL is used by both the app and migrate containers. The host
# `postgres` resolves on the docker network.
DATABASE_URL=postgres://10kdjo:replace-with-strong-random-password@postgres:5432/10kdjo

# ─── Auth.js ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-random-bytes-base64
AUTH_URL=https://app.10kdojo.org
AUTH_TRUST_HOST=true

# Google OAuth — leave empty for v1, populate later to enable Google sign-in.
# Authorized redirect URI in Google Cloud Console:
#   https://app.10kdojo.org/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Email (Resend) ───────────────────────────────────────────────────
# Sign up at https://resend.com, verify app.10kdojo.org as a sending domain
# (add the SPF/DKIM/DMARC TXT records they provide), then create an API
# key under https://resend.com/api-keys.
#
# Resend SMTP creds: username is literally "resend", password is the
# API key, host smtp.resend.com, port 465 (TLS) or 587 (STARTTLS).
EMAIL_SERVER=smtp://resend:re_replace_with_api_key@smtp.resend.com:587
EMAIL_FROM="10kdojo <noreply@app.10kdojo.org>"
