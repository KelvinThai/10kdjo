# Copy this file to .env.local and fill in the values.

# Postgres (matches docker-compose.dev.yml defaults)
DATABASE_URL=postgres://10kdjo:10kdjo_dev@localhost:5432/10kdjo

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-random-bytes-base64
AUTH_URL=http://localhost:3000

# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email (Nodemailer) — points at Mailpit in docker-compose.dev.yml for local dev
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM="10kdjo <noreply@10kdjo.local>"
